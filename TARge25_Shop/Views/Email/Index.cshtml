@model TARge25_Shop.Models.Email.EmailViewModel

@{
    ViewData["Title"] = "Send Email";
}

<div class="container mt-4">
    <h2>Send Email</h2>
    <hr />

    <form asp-controller="Email"
          asp-action="SendEmail"
          method="post"
          enctype="multipart/form-data">

        @Html.AntiForgeryToken()

        <div asp-validation-summary="All" class="text-danger"></div>

        <div class="mb-3">
            <label asp-for="To" class="form-label">To</label>
            <input asp-for="To" class="form-control" type="email" />
            <span asp-validation-for="To" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Subject" class="form-label">Subject</label>
            <input asp-for="Subject" class="form-control" />
            <span asp-validation-for="Subject" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Body" class="form-label">Message</label>
            <textarea asp-for="Body"
                      class="form-control"
                      rows="6"></textarea>
            <span asp-validation-for="Body" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Attachments" class="form-label">
                Attachments
            </label>
            <input asp-for="Attachments"
                   type="file"
                   multiple
                   class="form-control" />
        </div>

        <button type="submit" class="btn btn-primary">
            Send Email
        </button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
